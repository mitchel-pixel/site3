/* ========== БАЗА ========== */
*,
*::before,
*::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html { overflow-x: hidden; }

body {
    overflow-x: hidden;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

img { max-width: 100%; height: auto; display: block; }

:root {
    --ink: currentColor;
    --ink-2: #FF4FD8;
    --ink-3: #4FF8FF;
    --accent: #B59571;
    --dark: #333333;
    --container: 1076px;
}

/* ========== SECTION 1 (HERO) ========== */
.section_1 {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background-image: url(asserts/Rectangle_30.png);
    background-size: cover;
    background-position: center;
    display: flex;
    flex-direction: column;
}

.section_1_left {
    width: 120px;
    height: 100vh;
    background-color: #333333;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 50;
}

.section_1_left_top {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 30px;
}

.section_1_left_bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 30px;
}

/* Кнопка-бургер: скрыта на десктопе */
.burger {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    display: none;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
}

.header {
    width: 100%;
    max-width: 1825px;
    height: 100px;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding: 0 40px 0 160px; /* отступ слева под sidebar */
    margin-left: auto;
}

.header_nav {
    width: 465px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.header_nav ul {
    list-style: none;
    width: 254px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 5px;
}

.header_nav ul li a {
    text-decoration: none;
    color: white;
    font-size: 16px;
    transition: 0.3s;
}

.header_nav ul li a:hover { color: var(--accent); }

.button {
    width: 145px;
    height: 42px;
    background-color: var(--accent);
    border: none;
    font-weight: bold;
    color: white;
    cursor: pointer;
    transition: opacity .2s;
}
.button:hover { opacity: .9; }

.text_container {
    flex: 1;
    width: 100%;
    max-width: 1633px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 0 40px 80px 160px;
}

.text_container h1 {
    color: white;
    font-family: Arial, sans-serif;
    font-size: clamp(28px, 3.2vw, 46px);
    font-weight: 750;
    line-height: 1.5;
    text-align: left;
    transition: 1s;
}
.text_container h1:hover { color: var(--accent); }

/* ========== SECTION 2 (О РЕСТОРАНЕ) ========== */
.section_2 {
    width: 100%;
    padding: 120px 0;
}

.section_2_container {
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 20px;
}

.section_2_header {
    width: auto;
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 80px;
}

.section_2_label {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

.section_2_line {
    width: 50px;
    height: 3px;
    display: block;
}

.section_2_content {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 60px;
    align-items: start;
    /* margin-left: 195px; убираем — центрируем через контейнер */
}

.fx-focus {
    font: 600 75px/1.1 "JetBrains Mono", monospace;
    letter-spacing: .08em;
    color: var(--ink);
    margin: 5px 0;
    padding: 0;
}
.fx-focus b {
    font-weight: inherit;
    display: inline-block;
    animation: fx-focus 2.6s ease-in-out infinite;
    animation-delay: calc(var(--i) * .18s);
}
@keyframes fx-focus {
    0%, 100% { filter: blur(0);   opacity: 1; }
    50%      { filter: blur(7px); opacity: .35; }
}

.section_2_title {
    font-size: 64px;
    line-height: 1.1;
    font-weight: 600;
    color: #222;
    letter-spacing: -1px;
    margin: 0;
}

.fx-smoke {
    font: 800 15px/1.1 "JetBrains Mono", monospace;
    letter-spacing: .14em;
    color: var(--ink);
}
.fx-smoke b {
    font-weight: inherit;
    display: inline-block;
}
.fx-smoke b.is-visible {
    animation: fx-smoke 3.4s ease-in-out 1 forwards;
    animation-delay: calc(var(--i) * .16s);
}
@keyframes fx-smoke {
    0%, 42%   { transform: none; opacity: 1; filter: blur(0); color: var(--ink); }
    62%       { color: var(--ink-3); }
    78%       { transform: translate(6px, -22px) rotate(14deg) scale(1.45); opacity: 0; filter: blur(7px); }
    79%       { transform: translateY(10px) scale(.8); opacity: 0; filter: blur(4px); }
    92%, 100% { transform: none; opacity: 1; filter: blur(0); }
}

.section_2_text div {
    font-size: 14px;
    line-height: 1.6;
    color: #555;
    margin-bottom: 20px;
}
.section_2_text div:last-child { margin-bottom: 0; }

/* ========== SECTION 3 (МЕНЮ) ========== */
.section_3 {
    width: 100%;
    padding: 60px 0;
    display: flex;
    justify-content: center;
}

.section_3_container {
    width: 100%;
    max-width: var(--container);
    padding: 0 20px;
}

.section_3_container_info {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
}

.section_3_container_info_top {
    width: auto;
    display: flex;
    align-items: center;
    gap: 20px;
}

.section_3_container_info_p {
    font-weight: 700;
    font-size: 20px;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--dark);
}

.section_3_container_info_top img {
    width: 50px;
    height: 3px;
    display: block;
}

.section_3_container_text {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 60px;
}

.section_3_container_text_midle {
    width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
}

.fx_focus {
    font: 600 75px/1.1 "JetBrains Mono", monospace;
    letter-spacing: .08em;
    color: var(--ink);
    margin: 5px 0;
    padding: 0;
}
.fx_focus b {
    font-weight: inherit;
    display: inline-block;
    animation: fx_focus 2.6s ease-in-out infinite;
    animation-delay: calc(var(--i) * .18s);
}
@keyframes fx_focus {
    0%, 100% { filter: blur(0);   opacity: 1; }
    50%      { filter: blur(7px); opacity: .35; }
}

.section_3_container_text_midle p {
    width: 100%;
    max-width: 509px;
    display: flex;
    flex-direction: column;
    gap: 14px;
}
.section_3_container_text_midle p span {
    font-weight: 400;
    font-size: 18px;
    line-height: 1.4;
    color: var(--dark);
}

.section_3_container_info_bottom {
    width: 100%;
    display: flex;
    justify-content: space-around;
    gap: 20px;
    flex-wrap: wrap;
}

.section_3_left_bottom_card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
}

.section_3_left_bottom_card div {
    width: 100%;
    max-width: 290px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 30px;
}
.section_3_left_bottom_card div p {
    font-weight: 700;
    font-size: 20px;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--dark);
    text-align: center;
}
.section_3_left_bottom_card div img {
    width: 60px;
    height: 3px;
}

/* ========== SECTION 4 (ДОСТАВКА) ========== */
.section_4 {
    width: 100%;
    padding: 80px 0;
    display: flex;
    justify-content: center;
}

.section_4_conatainer {
    width: 100%;
    max-width: var(--container);
    padding: 0 20px;
}

.section_4_conatainer_info {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 60px;
}

.section_4_conatainer_info_top {
    width: auto;
    display: flex;
    align-items: center;
    gap: 20px;
}
.section_4_conatainer_info_top p {
    color: var(--dark);
    font-weight: 700;
    font-size: 20px;
    line-height: 140%;
    text-transform: uppercase;
}

.section_4_conatainer_left_text {
    width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
}

.section_4_conatainer_left_text h2 {
    font-weight: 700;
    font-size: clamp(32px, 4vw, 60px);
    line-height: 1.2;
    color: var(--dark);
}

.section_4_conatainer_right_text {
    width: 52%;
    display: flex;
    flex-direction: column;
    gap: 24px;
}
.section_4_conatainer_right_text p {
    width: 100%;
    max-width: 526px;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.4;
    color: var(--dark);
}

.section_4_conatainer_text_button {
    width: 100%;
    max-width: 414px;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
}
.section_4_button1 {
    border: none;
    padding: 12px 20px;
    width: 163px;
    height: 58px;
    background-color: var(--accent);
    cursor: pointer;
    font-weight: 700;
    font-size: 20px;
    color: white;
    transition: opacity 0.1s;
}
.section_4_button1:active { opacity: 0.8; }

.section_4_button2 {
    border: 1px solid rgba(51, 51, 51, 0.2);
    padding: 12px 19px;
    width: 221px;
    height: 58px;
    background: white;
    font-weight: 700;
    font-size: 20px;
    color: var(--dark);
    cursor: pointer;
    transition: background-color 0.2s;
}
.section_4_button2:hover { background-color: #f3f3f3; }

/* ========== SECTION 5 (КОНТАКТЫ) ========== */
.section_5 {
    width: 100%;
    padding: 80px 0;
    display: flex;
    justify-content: center;
}

.section_5_conatainer {
    width: 100%;
    max-width: var(--container);
    padding: 0 20px;
}

.section_5_conatainer_info {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 50px;
}

.section_5_conatainer_info_top {
    width: auto;
    display: flex;
    align-items: center;
    gap: 20px;
}
.section_5_conatainer_info_top p {
    font-weight: 700;
    font-size: 20px;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--dark);
}

.section_5_conatainer_info_bottom {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1.6fr 1fr;
    gap: 24px;
    align-items: start;
}

.cards_time {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.card_time {
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.card_time p {
    font-weight: 400;
    font-size: 18px;
    line-height: 1.4;
    color: var(--dark);
}

.time {
    font-weight: 700;
    font-size: clamp(36px, 4vw, 64px);
    line-height: 1.2;
    color: var(--accent);
}
.time span {
    font-weight: 700;
    font-size: clamp(18px, 2.2vw, 32px);
    line-height: 1.2;
}

/* Карта */
.section_5_conatainer_info_bottom iframe {
    width: 100%;
    height: 100%;
    min-height: 320px;
    border: 0;
    display: block;
}

/* Карточка контактов — убираем absolute, ставим в сетку */
.card_info {
    width: 100%;
    background: #5b5b5b;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40px 30px;
    position: static;
}

.card_info_container {
    width: 100%;
    max-width: 336px;
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.card_info_top {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
}
.card_info_top div {
    display: flex;
    align-items: center;
    gap: 15px;
}
.card_info_top div p {
    font-weight: 400;
    font-size: 16px;
    line-height: 1.4;
    color: white;
}
.vector1 { width: 15px; height: 15px; }

.card_info_medium {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.time1 {
    color: white;
    font-weight: 700;
    font-size: 20px;
    line-height: 1.4;
}
.time2 {
    color: white;
    font-weight: 700;
    font-size: 18px;
    line-height: 1.4;
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}
.time2 span {
    font-weight: 400;
    font-size: 18px;
    line-height: 1.4;
}

.card_info_bottom {
    width: 100%;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}
.card_info_bottom_btn1,
.card_info_bottom_btn2 {
    flex: 1 1 140px;
    min-height: 44px;
    padding: 10px;
    cursor: pointer;
    font-weight: 700;
    font-size: 16px;
    line-height: 1.4;
    text-align: center;
}
.card_info_bottom_btn1 {
    background-color: var(--accent);
    border: none;
    color: white;
}
.card_info_bottom_btn2 {
    border: 1px solid white;
    background: #5b5b5b;
    color: white;
}

/* ========== FOOTER ========== */
footer {
    width: 100%;
    min-height: 120px;
    background-color: var(--dark);
    display: flex;
    justify-content: center;
    padding: 20px 0;
}

.footer_container {
    width: 100%;
    max-width: var(--container);
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
}
.footer_p1, .footer_p2 {
    color: white;
    font-size: 16px;
    line-height: 1.4;
}
.footer_p2 { font-weight: 700; }

/* ============================================================
   АДАПТИВ
   ============================================================ */

/* Планшеты (≤1024px) */
@media (max-width: 1024px) {
    .header {
        padding: 0 24px 0 140px;
        height: 80px;
    }

    .text_container {
        padding: 0 24px 60px 140px;
    }

    .section_2_content {
        grid-template-columns: 1fr;
        gap: 40px;
    }

    .section_3_container_text_midle {
        flex-direction: column;
    }

    .section_5_conatainer_info_bottom {
        grid-template-columns: 1fr 1fr;
    }

    .section_5_conatainer_info_bottom iframe {
        grid-column: 1 / -1;
        min-height: 300px;
    }

    .section_4_conatainer_right_text {
        width: 100%;
    }
}

/* Малые планшеты / большие телефоны (≤768px) */
@media (max-width: 768px) {
    /* Sidebar превращаем в верхнюю панель */
    .section_1_left {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 70px;
        flex-direction: row;
        justify-content: space-between;
        padding: 0 20px;
        z-index: 100;
    }
    .section_1_left_top {
        flex-direction: row;
        padding: 0;
        gap: 16px;
    }
    .section_1_left_top a img {
        max-height: 36px;
    }
    .section_1_left_bottom {
        flex-direction: row;
        margin-bottom: 0;
        gap: 16px;
    }
    .section_1_left_bottom .icons {
        max-height: 20px;
        width: auto;
    }

    /* Бургер показываем */
    .burger { display: flex; }

    /* Навигация в виде выезжающей панели */
    .header {
        padding: 80px 20px 20px;
        height: auto;
        justify-content: flex-end;
    }

    .header_nav {
        position: fixed;
        top: 70px;
        left: 0;
        width: 100%;
        height: calc(100vh - 70px);
        background: rgba(51, 51, 51, 0.98);
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        padding: 40px 20px;
        gap: 24px;
        transform: translateX(-100%);
        transition: transform .3s ease;
        z-index: 90;
    }
    .header_nav.is-open { transform: translateX(0); }

    .header_nav ul {
        width: 100%;
        flex-direction: column;
        gap: 20px;
        height: auto;
    }
    .header_nav ul li a {
        font-size: 22px;
    }
    .header_nav .button {
        width: 100%;
        max-width: 280px;
        height: 48px;
        font-size: 16px;
    }

    .text_container {
        padding: 100px 20px 60px;
        align-items: flex-start;
    }

    .section_2 { padding: 60px 0; }
    .section_2_header { margin-bottom: 40px; }
    .section_2_title { font-size: clamp(36px, 8vw, 56px); }
    .fx-focus, .fx_focus { font-size: clamp(36px, 9vw, 60px); }

    .section_3,
    .section_4,
    .section_5 { padding: 50px 0; }

    .section_3_container_text { gap: 40px; }

    .section_3_container_info_bottom {
        justify-content: center;
    }

    .section_4_conatainer_left_text {
        flex-direction: column;
        gap: 24px;
    }

    .section_4_conatainer_text_button {
        flex-direction: column;
        max-width: 100%;
    }
    .section_4_button1,
    .section_4_button2 {
        width: 100%;
        height: 52px;
        font-size: 16px;
    }

    .section_5_conatainer_info_bottom {
        grid-template-columns: 1fr;
    }

    .section_5_conatainer_info_bottom iframe {
        min-height: 260px;
    }

    .footer_container {
        flex-direction: column;
        align-items: flex-start;
    }
}

/* Мобильные (≤480px) */
@media (max-width: 480px) {
    .section_2_container,
    .section_3_container,
    .section_4_conatainer,
    .section_5_conatainer,
    .footer_container {
        padding: 0 16px;
    }

    .text_container h1 {
        font-size: 24px;
        line-height: 1.4;
    }

    .section_2_label,
    .section_3_container_info_p,
    .section_4_conatainer_info_top p,
    .section_5_conatainer_info_top p {
        font-size: 16px;
    }

    .section_2_title { font-size: 34px; }
    .fx-focus, .fx_focus { font-size: 34px; }

    .section_3_container_text_midle p span,
    .section_4_conatainer_right_text p,
    .card_time p {
        font-size: 15px;
    }

    .cards_time {
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .time { font-size: 40px; }
    .time span { font-size: 20px; }

    .card_info { padding: 30px 20px; }
    .card_info_top div p,
    .time2,
    .time2 span { font-size: 14px; }

    .card_info_bottom_btn1,
    .card_info_bottom_btn2 {
        font-size: 14px;
        min-height: 44px;
    }

    .footer_p1, .footer_p2 {
        font-size: 14px;
    }
}

/* Убираем горизонтальный скролл при открытом меню */
body.no-scroll { overflow: hidden; }